import numpy as np

from classical_diffusion.analysis import calculate_intra_cell_factor
from classical_diffusion.system import (
    PeriodicSystemFCC,
    UnitSystem,
)

system = PeriodicSystemFCC(
    gamma=1e11,
    temperature=114,
    m=8e-27,
    delta_x=3e-10,
    barrier_energy=4e-21,
    units=UnitSystem(),
)

direction = np.array([0, 1])
delta_k = tuple(
    2 * np.pi / system.delta_x * 0.2 * direction / np.linalg.norm(direction)
)

normalized_system = system.with_normalized_units()
A = calculate_intra_cell_factor(normalized_system, delta_k=np.asarray([0, 1]))
print(A)
